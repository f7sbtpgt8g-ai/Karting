# Client-safe: both of these are designed to ship in the browser bundle and
# are protected by Row Level Security (see supabase/migrations/0002_*.sql).

# The PROJECT URL -- host only, no path.
#
# The dashboard also shows a "Data API"/RESTful endpoint ending in /rest/v1.
# That is not this. supabase-js appends /auth/v1, /rest/v1 and /storage/v1
# itself, so pasting the REST endpoint here sends sign-ups to
# /rest/v1/auth/v1/signup and PostgREST answers with the memorably unhelpful
# "Invalid path specified in request URL". src/lib/supabase/env.ts rejects it
# with something more useful.
NEXT_PUBLIC_SUPABASE_URL=https://udsfctfspucqlbrjiltl.supabase.co

# The publishable (anon) key -- `sb_publishable_...` or the older JWT-shaped
# anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# NEVER set the service-role/secret key here. It bypasses RLS entirely, and
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time --
# publishing one would hand every visitor unrestricted access to the database.
# It belongs only in the background worker's environment (see worker/).
